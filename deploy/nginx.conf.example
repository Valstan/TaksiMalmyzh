# Секция nginx на боксе. Скопировать, подставив значения в угловых скобках.
#
# Главное, что здесь неочевидно: слушаем ТОЛЬКО :80. Внешние 80 и 443 терминирует
# прокси хостера и форвардит оба на внутренний :80 с X-Forwarded-Proto. Свой :443
# снаружи недостижим, certbot для внешнего 443 бесполезен — сертификат ставится
# через панель хостера (G150).
#
# Домены матрёшки живут в ОДНОЙ секции, а не в нескольких: приложение одно, и
# какое лицо показать, оно решает само по заголовку Host (lib/sites.ts). Отдельные
# server-блоки на домен означали бы, что список доменов надо держать одинаковым в
# двух местах — он немедленно разойдётся.
#
# Плейсхолдер домена ниже — это СПИСОК через пробел: nginx понимает
# `server_name a b c;`. Добавить домен = перезапустить bootstrap-box.sh с полным
# списком (см. его шапку) и выпустить сертификат на новый домен в панели.
# (Здесь плейсхолдер не написан дословно нарочно: подстановка идёт обычным sed
# по всему файлу и переписала бы его прямо в этом абзаце.)
#
# Редирект и proxy_pass ниже используют $host, а не фиксированное имя: человек
# должен остаться на том домене, на который пришёл, иначе матрёшка схлопнется в
# один сайт.

server {
    listen 80;
    listen [::]:80;
    server_name <домен>;

    # Редирект на https — ТОЛЬКО по X-Forwarded-Proto. По $scheme получается петля:
    # внутрь всегда приходит http, сколько бы раз браузер ни возвращался.
    if ($http_x_forwarded_proto = "http") {
        return 301 https://$host$request_uri;
    }

    # Пока приложение не готово к этапу B, стенд закрывается здесь — и тогда
    # IP посторонних в логи не попадают вместе с их запросами к приложению.
    # auth_basic "closed";
    # auth_basic_user_file <путь к файлу паролей>;

    # Карта, глифы и спрайты неизменны между релизами и уже помечены immutable
    # самим приложением. Отдаём их напрямую, не тревожа Node.
    location /map/ {
        alias <каталог приложения>/current/public/map/;

        # ⚠️ Типы задаются здесь, а не берутся из общего mime.types: в стоковом
        # mime.types нет расширения .mjs, и воркер MapLibre уезжал браузеру как
        # application/octet-stream. Модульный скрипт с не-JS типом браузер
        # отказывается исполнять по спецификации — карта оставалась серой.
        #
        # Локально этот баг не виден вообще: в разработке файл отдаёт Next,
        # который тип знает. На проде тот же файл отдаёт nginx в обход Next —
        # ради скорости, — и вместе со скоростью берёт на себя типы. Проверять
        # такие вещи можно только на проде и только в браузере: смоук на
        # `curl` видел честные 200 и ничего подозрительного.
        #
        # Блок types ЗАМЕНЯЕТ карту типов для этого location, поэтому здесь
        # перечислено всё, что лежит под /map/, а не одна недостающая строка.
        types {
            application/javascript   mjs js;
            application/json         json;
            image/png                png;
            text/plain               txt md;
            application/octet-stream pmtiles pbf;
        }

        # Range-запросы обязательны: браузер читает .pmtiles диапазонами байт,
        # без них карта не работает вообще.
        add_header Accept-Ranges bytes;
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    location / {
        proxy_pass http://127.0.0.1:<локальный порт>;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Forwarded-Host $host;

        # X-Forwarded-For намеренно НЕ ставится: приложению адрес посетителя не
        # нужен ни для чего, а как только он приходит — он попадает в логи и
        # ошибки. Меньше чужих персональных данных в системе (M0.A §3.6).

        proxy_read_timeout 60s;
    }

    client_max_body_size 1m;
}
