# systemd-юнит приложения. Скопировать, подставив значения в угловых скобках.
#
# Реальные путь и порт в репозиторий не пишутся (AGENTS.md, recon-поверхность) —
# они в карточке проекта на стороне brain.

[Unit]
Description=TaksiMalmyzh (Next.js standalone)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=<пользователь приложения>
WorkingDirectory=<каталог приложения>/current

# Слушаем только localhost: наружу публикует nginx бокса, напрямую служба
# из интернета доступна быть не должна.
Environment=HOSTNAME=127.0.0.1
Environment=PORT=<локальный порт>
Environment=NODE_ENV=production

# Секреты — отдельным файлом вне репозитория и вне релизного пакета.
EnvironmentFile=-<каталог приложения>/shared/.env

# Мастер-ключ шифрования трасс подаётся credential'ом, а НЕ переменной окружения
# (решение владельца 2026-08-30): бокс общий с тремя проектами, а переменные окружения
# процесса читаются соседями через /proc/<pid>/environ. Credential systemd кладёт в
# приватный tmpfs, доступный только этой службе; приложение читает его по пути
# $CREDENTIALS_DIRECTORY/track_key (lib/track-crypto.ts).
#
# Строка ниже закомментирована в шаблоне намеренно: на боксе она ставится drop-in'ом
# /etc/systemd/system/<служба>.service.d/track-key.conf, чтобы пережить повторный прогон
# bootstrap-box.sh, который этот файл перезаписывает целиком.
#
# LoadCredential=track_key:<файл ключа вне репозитория, root:root, 600>
#
# Тем же способом подаётся токен записи этапа A (etap_a_token) — и по той же причине, а не
# из симметрии: сосед по общему боксу, прочитавший токен из /proc/<pid>/environ, сможет
# писать поездки в нашу систему, то есть заводить ЧУЖИЕ персональные данные. Это ровно та
# граница A→B, которую гейт и защищает.
#
# LoadCredential=etap_a_token:<файл токена вне репозитория, root:root, 600>

ExecStart=/usr/bin/node server.js

Restart=on-failure
RestartSec=3

# Потолок памяти обязателен, а не желателен: бокс маленький и без swap, жильцов
# несколько. Без лимита утечка в одном приложении роняет соседей, а не себя.
# Рантайм standalone держит около 150-300 МБ, так что запас двукратный.
MemoryMax=640M

# Приложение не должно уметь ничего лишнего.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=<каталог приложения>

# ProtectHome здесь стоять НЕ должен, хотя просится: каталог приложения лежит
# в /home, и с ProtectHome=true служба не может даже войти в свой рабочий
# каталог — systemd отвечает 200/CHDIR и уходит в цикл перезапусков.

# Журнал не должен превращаться в хранилище чужих данных: при падении systemd
# пишет в общий журнал, а туда не место ни адресам посетителей, ни строкам
# подключения к базе (письмо brain 2026-08-29 о recon в логах).
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
