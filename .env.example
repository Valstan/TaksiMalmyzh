# Пример переменных окружения. Скопировать в .env.local (он в .gitignore) и заполнить.
#
# Реальные значения в репозиторий не попадают никогда — ни здесь, ни в комментариях
# (AGENTS.md, «Секреты не должны жить в репозитории даже под защитой .gitignore»).
# На проде эти переменные лежат в shared/.env вне релизного пакета, а в CI —
# секретами GitHub, НЕ в vars: значения vars печатаются в публичный лог прогона.

# --- приложение ---

# Порт локального сервера. Наружу приложение публикует nginx бокса.
PORT=3000

# --- база данных ---

# Локально заводится одной командой:
#
#     npm run db:setup
#
# Скрипт создаёт роль и базу проекта, отзывает у PUBLIC право CONNECT (на этой
# машине один сервер PostgreSQL обслуживает несколько репозиториев, и роль одного
# проекта не должна ходить в базу другого) и записывает строку подключения
# в .env.local. Пароль генерируется и в репозиторий не попадает.
#
# На проде PostgreSQL уже стоит на боксе — проекту нужна своя база и роль,
# а не свой сервер.
#
# DATABASE_URI=postgres://<пользователь>:<пароль>@127.0.0.1:5432/<база>

# --- ключи ---

# Ключ шифрования координат трассы. Живёт ВНЕ базы данных с первого дня:
# ретрофит шифрования дороже, чем закладка (M0.A §3.4, GO_LIVE этап A).
#
# Формат: «<эпоха>:<base64 32 байт>», например 1:AAAA…  Несколько эпох через запятую —
# для ротации: заворачиваем всегда старшей, разворачиваем любой известной. Уничтожение
# ключа эпохи — второй механизм уничтожения данных, который дотягивается до резервных
# копий, куда DROP партиции не дотягивается (M0.A §4.3).
#
# Сгенерировать: node -e "console.log('1:'+require('crypto').randomBytes(32).toString('base64'))"
#
# На проде живёт в systemd-credential, а НЕ в переменной окружения — решение владельца
# 2026-08-30: бокс общий с тремя проектами, а переменные окружения процесса читаются
# соседями через /proc/<pid>/environ.
#
# PAYLOAD_SECRET=
# TRACK_ENCRYPTION_KEY=

# --- запись поездок: ВЫКЛЮЧЕНА ПО УМОЛЧАНИЮ ---
#
# Стенд открыт наружу (решение владельца 2026-08-29). Открытый эндпоинт записи означал бы,
# что поездку может записать посторонний, — то есть чужие персональные данные, то есть
# ЭТАП B, в который проект не входил (M0.A §8.0).
#
# Право записи даёт ВХОД в приложение обычной сессией — той же, что и в админке. Токена,
# который надо где-то прочитать и куда-то ввести, нет намеренно: у процедуры со шагом
# «прочитай секрет глазами» этот секрет рано или поздно утекает, что и случилось
# 2026-08-30 с прежним общим токеном. Секрета, которого нет, не утекает.
#
# Переменная ниже — мастер-выключатель этапа записи, не секрет. Её отсутствие означает,
# что эндпоинта записи не существует (404).
#
# TRACK_RECORDING=on
